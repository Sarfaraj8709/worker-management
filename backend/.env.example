PORT=5000
MONGODB_URI=mongodb://localhost:27017/worker-management

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

NODE_ENV=development

# Frontend origin used to build email verification / reset links
CLIENT_URL=http://localhost:5173

# SMTP credentials for verification & password-reset emails.
# When unset, emails are printed to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
